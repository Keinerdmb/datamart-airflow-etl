# Variables de entorno - DataMart S.A.S.

# Usuario de Linux para permisos en contenedores
AIRFLOW_UID=50000

# Base de datos interna de Airflow (metadatos)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_pass
AIRFLOW_DB_NAME=airflow_metadata
AIRFLOW_DB_PORT=5432

# Base de datos del Data Warehouse analítico
DW_DB_USER=dw_admin
DW_DB_PASSWORD=dw_secret_pass
DW_DB_NAME=datamart_dw
DW_DB_PORT=5433

# Administrador de la interfaz web de Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=DataMart
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@datamart.com

# Conexión automática de Airflow al Data Warehouse
AIRFLOW_CONN_POSTGRES_DW=postgresql://dw_admin:dw_secret_pass@postgres-dw:5432/datamart_dw

# Variables operativas del pipeline
AIRFLOW_VAR_RAW_DATA_PATH=/opt/airflow/data/raw
AIRFLOW_VAR_PROCESSED_DATA_PATH=/opt/airflow/data/processed
AIRFLOW_VAR_ENV=development
